# Sao chép file này thành .env và điền cấu hình cục bộ; Django tự nạp .env qua python-dotenv.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=Quanlypho
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Mã ngân hàng theo VietQR, số tài khoản, tên chủ tài khoản
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
DELIVERY_FLAT_FEE=30000
DELIVERY_BASE_FEE=15000
DELIVERY_FEE_PER_KM=8000
DELIVERY_MAX_KM=10
RESTAURANT_LAT=10.7769
RESTAURANT_LNG=106.7009
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-password

# TH4: chính sách mặc định có thể cấu hình
CHECKOUT_HOLD_MINUTES=15
SAVED_ACCOUNT_DAYS=7
CHECKIN_BASE_POINTS=1
REVIEW_POINTS=5
REFERRAL_POINTS=50
ISSUE_REPORT_HOURS=2
TIER_VOUCHER_DAYS=90
# Chỉ điền hotline thật và mã voucher sinh nhật đã tạo trong trang Khuyến mãi
VIP_HOTLINE=
BIRTHDAY_STANDARD_VOUCHER=
BIRTHDAY_SPECIAL_VOUCHER=
