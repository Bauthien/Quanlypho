# Sao chép các giá trị cần dùng vào environment của shell/hosting; Django không nạp file .env tự động.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=Quanlypho
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Mã ngân hàng theo VietQR, số tài khoản, tên chủ tài khoản
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
DELIVERY_FLAT_FEE=30000
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-password
